---
const today = new Date();
---

<footer class="bg-background-dark border-t border-white/5 py-12">
    <div class="max-w-[1280px] mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 mb-12">
            <div class="col-span-1 md:col-span-1">
                <div class="flex items-center gap-3 text-white mb-6">
                    <div class="w-6 h-6 text-primary border border-primary/50 rounded-sm">
                        <!-- Simplified logo placeholder for footer -->
                    </div>
                    <h2 class="text-lg font-bold tracking-tight">FACTORY 471</h2>
                </div>
                <p class="text-sm text-slate-500 mb-6">
                    Building the future of mobile interaction, one pixel at a time.
                </p>
            </div>
            <div class="col-span-1">
                <h3 class="text-white font-bold mb-4">Products</h3>
                <ul class="flex flex-col gap-2">
                    <li><a class="text-slate-400 hover:text-primary transition-colors text-sm" href="/ssak-photo-cleaner.html">SSAK</a></li>
                    <li><a class="text-slate-400 hover:text-primary transition-colors text-sm" href="/snow-record.html">Snow Record</a></li>
                </ul>
            </div>
            <div class="col-span-1">
                <h3 class="text-white font-bold mb-4">Company</h3>
                <ul class="flex flex-col gap-2">
                    <li><a class="text-slate-400 hover:text-primary transition-colors text-sm" href="/about.html">About Us</a></li>
                    <li><a class="text-slate-400 hover:text-primary transition-colors text-sm" href="mailto:contact@factory471.xyz">Contact</a></li>
                </ul>
            </div>
            <div class="col-span-1">
                <h3 class="text-white font-bold mb-4">Legal</h3>
                <ul class="flex flex-col gap-2">
                    <li><a class="text-slate-400 hover:text-primary transition-colors text-sm" href="/snow-record-privacy.html">Privacy Policy</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-slate-500 text-sm">&copy; {today.getFullYear()} FACTORY 471. All rights reserved.</p>
        </div>
    </div>
</footer>
